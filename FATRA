function showCart(){const co=document.getElementById('cartOverlay');const cb=document.getElementById('cartBody');if(!cart.length){co.classList.remove('show');cb.innerHTML='';return}co.classList.add('show');let subtotal=cart.reduce((n,x)=>n+x.price*x.qty,0);let cheapest=Math.min(...cart.map(x=>x.price));let discountAmount=quizDiscount?cheapest*quizDiscount/100:0;let total=subtotal-discountAmount;cb.innerHTML=cart.map((x,i)=>'<div class="cart-line"><div><b>'+x.name+(x.size?' — Size '+x.size:'')+'</b><div class="muted">$'+x.price.toFixed(2)+' each</div></div><div class="qty"><button data-dec="'+i+'">−</button><span>'+x.qty+'</span><button data-inc="'+i+'">+</button></div><button class="outline" data-remove="'+i+'">Remove</button></div>').join('')+'<div style="display:flex;justify-content:space-between;padding-top:14px"><span>Subtotal</span><span>$'+subtotal.toFixed(2)+'</span></div>'+(discountAmount?'<div style="display:flex;justify-content:space-between;color:var(--g);padding-top:8px"><span>Quiz discount ('+quizDiscount+'% on one cheapest item)</span><span>−$'+discountAmount.toFixed(2)+'</span></div>':'')+'<div class="cart-total"><span>Total</span><span>$'+total.toFixed(2)+'</span></div><p class="notice">Quiz discount applies once to one unit of the cheapest product in this cart.</p><form id="checkoutForm" action="https://formsubmit.co/karelhrubl@gmail.com" method="POST"><input type="hidden" name="_subject" value="New FATRA shop order"><input type="hidden" name="_template" value="table"><input type="hidden" name="_captcha" value="true"><input type="text" name="_honey" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" aria-hidden="true"><input type="hidden" name="Order summary" id="orderSummary"><input type="hidden" name="Discount" value="Quiz discount applies to one cheapest item"><div class="form-field"><label for="customerName">Full name</label><input id="customerName" name="Full name" required autocomplete="name" placeholder="Your name"></div><div class="form-field"><label for="customerEmail">Email</label><input id="customerEmail" name="email" type="email" required autocomplete="email" placeholder="you@example.com"></div><div class="form-field"><label for="customerPhone">Phone number (for easier communication)</label><input id="customerPhone" name="Phone number" type="tel" required autocomplete="tel" placeholder="+420 123 456 789" pattern="[+0-9() .-]{7,}" title="Enter a valid phone number"></div><div class="form-field"><label for="customerAddress">Street and house number</label><input id="customerAddress" name="Street and house number" required autocomplete="street-address" placeholder="Street and house number"></div><div class="form-field"><label for="customerCity">City</label><input id="customerCity" name="City" required autocomplete="address-level2" placeholder="City"></div><div class="form-field"><label for="customerPostal">Postal Code</label><input id="customerPostal" name="Postal Code" required autocomplete="postal-code" placeholder="e.g. 779 00"></div><div class="form-field"><label for="customerCountry">Country</label><input id="customerCountry" name="Country" required autocomplete="country-name" placeholder="Country"></div><button class="btn" type="submit">SEND ORDER</button><p class="notice">Test shop: this form sends order details by email through FormSubmit. No payment is taken.</p></form>';cb.querySelectorAll('[data-inc]').forEach(b=>b.onclick=()=>{cart[+b.dataset.inc].qty++;cartCount();showCart()});cb.querySelectorAll('[data-dec]').forEach(b=>b.onclick=()=>{let i=+b.dataset.dec;cart[i].qty--;if(cart[i].qty<=0)cart.splice(i,1);cartCount();if(cart.length)showCart();else co.classList.remove('show')});cb.querySelectorAll('[data-remove]').forEach(b=>b.onclick=()=>{cart.splice(+b.dataset.remove,1);cartCount();if(cart.length)showCart();else co.classList.remove('show')});document.getElementById('checkoutForm').onsubmit=(event)=>{if(!cart.length){event.preventDefault()